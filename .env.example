# Email (contact form + AI assistant callback requests) — sent from your Gmail via Nodemailer.
# GMAIL_APP_PASSWORD is a Google "App password" (myaccount.google.com/apppasswords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where messages are delivered
CONTACT_TO_EMAIL=souravgokul4@gmail.com

# AI chat assistant (Google AI Studio → Get API key). Free tier works.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
